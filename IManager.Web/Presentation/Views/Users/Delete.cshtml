@model AccountDetailsViewModel

@{
    var action = Model.IsActive ? "Desativar" : "Ativar";
    ViewData["Title"] = $"{action} Usuário";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">@action Usuário</h5>
                </div>

                <div class="card-body">
                    <div class="alert @(Model.IsActive ? "alert-warning" : "alert-info") mb-4">
                        Tem certeza que deseja <strong>@action.ToLower()</strong> o usuário <strong>@Model.FullName</strong>?
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Nome Completo</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">CPF</dt>
                        <dd class="col-sm-8">@MaskHelper.MaskCpf(Model.DocumentNumber)</dd>

                        <dt class="col-sm-4">Data de Nascimento</dt>
                        <dd class="col-sm-8">@Model.BirthDate.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Perfil</dt>
                        <dd class="col-sm-8">@Model.Role</dd>

                        <dt class="col-sm-4">Cargo</dt>
                        <dd class="col-sm-8">@Model.JobTitle</dd>
                    </dl>
                </div>

                <div class="card-footer bg-white d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                    <form asp-action="Delete" method="post" class="m-0">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn @(Model.IsActive ? "btn-danger" : "btn-success")">@action</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
