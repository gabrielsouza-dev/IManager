@model DetailsUserViewModel

@{
    ViewData["Title"] = "Detalhes do Usuário";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Detalhes do Usuário</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">@Model.FullName</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Nome Completo</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">CPF</dt>
                <dd class="col-sm-9">@MaskHelper.MaskCpf(Model.DocumentNumber)</dd>

                <dt class="col-sm-3">Data de Nascimento</dt>
                <dd class="col-sm-9">@Model.BirthDate.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3">E-mail</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Telefone</dt>
                <dd class="col-sm-9">@(!string.IsNullOrEmpty(Model.PhoneNumber) ? Model.PhoneNumber : "Não informado")</dd>

                <dt class="col-sm-3">Perfil</dt>
                <dd class="col-sm-9">@Model.Role</dd>

                <dt class="col-sm-3">Situação</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Ativo" : "Inativo")
                    </span>
                </dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">Informações Profissionais</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Empresa</dt>
                <dd class="col-sm-9">@Model.Info.CompanyTradeName</dd>

                <dt class="col-sm-3">CNPJ da Empresa</dt>
                <dd class="col-sm-9">@MaskHelper.MaskCnpj(Model.Info.CompanyDocumentNumber)</dd>

                <dt class="col-sm-3">Setor</dt>
                <dd class="col-sm-9">@Model.Info.Department</dd>

                <dt class="col-sm-3">Cargo</dt>
                <dd class="col-sm-9">@Model.Info.JobTitle</dd>

                <dt class="col-sm-3">Salário Base</dt>
                <dd class="col-sm-9">@MaskHelper.MaskCurrency(Model.BaseSalary)</dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">Indicadores Salariais (Ano Atual)</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Salário Líquido Anual</dt>
                <dd class="col-sm-9">@MaskHelper.MaskCurrency(Model.Info.LastAnnualNetSalary)</dd>

                <dt class="col-sm-3">Salário Bruto Anual</dt>
                <dd class="col-sm-9">@MaskHelper.MaskCurrency(Model.Info.LastAnnualGrossSalary)</dd>

                <dt class="col-sm-3">Média Salarial Líquida</dt>
                <dd class="col-sm-9">@MaskHelper.MaskCurrency(Model.Info.AverageNetSalary)</dd>

                <dt class="col-sm-3">Média Salarial Bruta</dt>
                <dd class="col-sm-9">@MaskHelper.MaskCurrency(Model.Info.AverageGrossSalary)</dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            Editar
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Voltar
        </a>
    </div>
</div>
