@model DetailsDepartmentViewModel

@{
    ViewData["Title"] = "Detalhes do Setor";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Detalhes do Setor</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">@Model.Name</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                @if (User.IsInRole(Role.Staff))
                {
                    <dt class="col-sm-3">Empresa</dt>
                    <dd class="col-sm-9">@Model.Company.TradeName</dd>

                    <dt class="col-sm-3">Razão Social</dt>
                    <dd class="col-sm-9">@Model.Company.LegalName</dd>

                    <dt class="col-sm-3">CNPJ</dt>
                    <dd class="col-sm-9">@MaskHelper.MaskCnpj(Model.Company.DocumentNumber)</dd>
                }

                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Data de Cadastro</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">Situação</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Ativo" : "Inativo")
                    </span>
                </dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">Informações do Setor</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Total de Cargos</dt>
                <dd class="col-sm-9">@Model.Info.JobTitleCount</dd>

                <dt class="col-sm-3">Total de Funcionários</dt>
                <dd class="col-sm-9">@Model.Info.EmployeeCount</dd>

                <dt class="col-sm-3">Salário Médio</dt>
                <dd class="col-sm-9">@Model.Info.AverageSalary.ToString("C")</dd>

                <dt class="col-sm-3">Cargo Mais Comum</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Info.MostCommonJobTitle) ? "-" : Model.Info.MostCommonJobTitle)
                </dd>

                <dt class="col-sm-3">Cargo com Maior Custo</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Info.HighestCostJobTitleName) ? "-" : Model.Info.HighestCostJobTitleName)
                </dd>

                <dt class="col-sm-3">Custo do Cargo Mais Caro</dt>
                <dd class="col-sm-9">@Model.Info.HighestCostJobTitleValue.ToString("C")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            Editar
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Voltar
        </a>
    </div>
</div>
