@model DepartmentViewModel

@{
    var action = Model.IsActive ? "Desativar" : "Ativar";
    ViewData["Title"] = $"{action} Setor";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">@action Setor</h5>
                </div>

                <div class="card-body">
                    <div class="alert @(Model.IsActive ? "alert-warning" : "alert-info") mb-4">
                        Tem certeza que deseja <strong>@action.ToLower()</strong> o setor <strong>@Model.Name</strong>?
                    </div>

                    <dl class="row mb-0">
                        @if (User.IsInRole(Role.Staff))
                        {
                            <dt class="col-sm-4">Empresa</dt>
                            <dd class="col-sm-8">@Model.Company.TradeName</dd>

                            <dt class="col-sm-4">CNPJ</dt>
                            <dd class="col-sm-8">@MaskHelper.MaskCnpj(Model.Company.DocumentNumber)</dd>
                        }

                        <dt class="col-sm-4">Nome</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Data de Cadastro</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>

                <div class="card-footer bg-white d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                    <form asp-action="Delete" method="post" class="m-0">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn @(Model.IsActive ? "btn-danger" : "btn-success")">@action</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
