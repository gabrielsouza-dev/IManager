@model DetailsJobTitleViewModel

@{
    ViewData["Title"] = "Detalhes do Cargo";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Detalhes do Cargo</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">@Model.Name</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                @if (User.IsInRole(Role.Staff))
                {
                    <dt class="col-sm-3">Empresa</dt>
                    <dd class="col-sm-9">@Model.CompanyTradeName</dd>

                    <dt class="col-sm-3">CNPJ</dt>
                    <dd class="col-sm-9">@MaskHelper.MaskCnpj(Model.CompanyDocumentNumber)</dd>
                }

                <dt class="col-sm-3">Setor</dt>
                <dd class="col-sm-9">@Model.DepartmentName</dd>

                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Perigoso</dt>
                <dd class="col-sm-9">@(Model.IsHazard ? "Sim" : "Não")</dd>

                <dt class="col-sm-3">Insalubre</dt>
                <dd class="col-sm-9">@(Model.IsUnhealthy ? "Sim" : "Não")</dd>

                <dt class="col-sm-3">Comissionado</dt>
                <dd class="col-sm-9">@(Model.IsCommissioned ? "Sim" : "Não")</dd>

                <dt class="col-sm-3">Banco de Horas</dt>
                <dd class="col-sm-9">@(Model.IsTimeBank ? "Sim" : "Não")</dd>

                <dt class="col-sm-3">Horas Diárias</dt>
                <dd class="col-sm-9">@Model.DailyHours.ToString(@"hh\:mm")</dd>

                <dt class="col-sm-3">Situação</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Ativo" : "Inativo")
                    </span>
                </dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">Informações do Cargo</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Quantidade de Funcionários</dt>
                <dd class="col-sm-9">@Model.Info.EmployeeCount</dd>

                <dt class="col-sm-3">Salário Médio</dt>
                <dd class="col-sm-9">@Model.Info.AverageSalary.ToString("C")</dd>

                <dt class="col-sm-3">Custo Total</dt>
                <dd class="col-sm-9">@Model.Info.TotalCost.ToString("C")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            Editar
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Voltar
        </a>
    </div>
</div>
