@model EditJobTitleViewModel

@{
    ViewData["Title"] = "Editar Cargo";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Editar Cargo</h2>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Dados do Cargo</h5>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row mb-3">
                    <label asp-for="Name" class="col-sm-3 col-form-label">Nome <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Adicionais</label>
                    <div class="col-sm-9 pt-2">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" asp-for="IsHazard" />
                            <label class="form-check-label" asp-for="IsHazard">Perigoso</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" asp-for="IsUnhealthy" />
                            <label class="form-check-label" asp-for="IsUnhealthy">Insalubre</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" asp-for="IsCommissioned" />
                            <label class="form-check-label" asp-for="IsCommissioned">Comissionado</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Banco de Horas</label>
                    <div class="col-sm-9 pt-2">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="IsTimeBank" value="true" id="timeBankYes" />
                            <label class="form-check-label" for="timeBankYes">Com Banco de Horas</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="IsTimeBank" value="false" id="timeBankNo" />
                            <label class="form-check-label" for="timeBankNo">Sem Banco de Horas</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <label asp-for="DailyHours" class="col-sm-3 col-form-label">Horas Diárias <span class="text-danger">*</span></label>
                    <div class="col-sm-9">
                        <input type="time" asp-for="DailyHours" class="form-control" />
                        <span asp-validation-for="DailyHours" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
