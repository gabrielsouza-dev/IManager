@model IEnumerable<DateOnly>

@{
    ViewData["Title"] = "Folhas de pagamento";
}

<div class="btn-group w-100" role="group">
    <input type="radio" class="btn-check" name="tabs" id="pending" checked>
    <label class="btn btn-outline-primary" for="pending">
        Pendentes
    </label>

    <input type="radio" class="btn-check" name="tabs" id="processed">
    <label class="btn btn-outline-primary" for="processed">
        Processados
    </label>
</div>

<label for="data" class="mt-3">
    Competência:
    <select id="data" name="data">
        <option value="">Selecione um mês</option>

        @foreach (var data in Model)
        {
            <option value="@data.ToString("yyyy-MM-dd")">
                @data.ToString("MM/yyyy")
            </option>
        }
    </select>
</label>

<div class="mt-3" id="tableContainer"></div>

<script>
    const pending = document.getElementById("pending");
    const processed = document.getElementById("processed");
    const tableContainer = document.getElementById("tableContainer");
    const data = document.getElementById("data");

    let currentPage = 1;
    let currentPageSize = 10;

    function updateTabs() {
        currentPage = 1;
        loadTable();
    }

    function loadTable() {
        tableContainer.innerHTML = "";

        if (!data.value) {
            return;
        }

        if (pending.checked) {
            fetchPayrollPending(data.value);
        } else {
            fetchPayrollProcessed(data.value);
        }
    }

    function fetchPayrollPending(selectedDate) {
        fetch(`/Payrolls/_PayrollPendingTable?competenceDate=${selectedDate}&page=${currentPage}&pageSize=${currentPageSize}`)
            .then(response => response.text())
            .then(html => {
                tableContainer.innerHTML = html;
            })
            .catch(error =>
                console.error('Error fetching payrolls:', error)
            );
    }

    function fetchPayrollProcessed(selectedDate) {
        fetch(`/Payrolls/_PayrollProcessedTable?competenceDate=${selectedDate}&page=${currentPage}&pageSize=${currentPageSize}`)
            .then(response => response.text())
            .then(html => {
                tableContainer.innerHTML = html;
            })
            .catch(error =>
                console.error('Error fetching payrolls:', error)
            );
    }

    // Paginação dos partials (_AjaxPagination)
    tableContainer.addEventListener("click", function (e) {
        const link = e.target.closest("a[data-page]");
        if (!link) return;

        e.preventDefault();
        currentPage = parseInt(link.dataset.page);
        loadTable();
    });

    tableContainer.addEventListener("change", function (e) {
        const select = e.target.closest("select[data-page-size]");
        if (!select) return;

        currentPageSize = parseInt(select.value);
        currentPage = 1;
        loadTable();
    });

    pending.addEventListener("change", updateTabs);
    processed.addEventListener("change", updateTabs);

    data.addEventListener("change", function () {
        updateTabs();
    });

    const savedCompetenceDate =
        sessionStorage.getItem('payrollCompetenceDate');

    if (savedCompetenceDate) {
        data.value = savedCompetenceDate;

        sessionStorage.removeItem('payrollCompetenceDate');

        updateTabs();
    }
</script>