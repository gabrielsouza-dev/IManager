@model PagedResult<PayrollViewModel>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Funcionário</th>
            <th class="text-center">Competência</th>
            <th class="text-center">Início do Período</th>
            <th class="text-center">Fim do Período</th>
            <th class="text-center">Horas Trabalhadas</th>
            <th class="text-center">Dias Trabalhados</th>
            <th class="text-center">Consistente</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="8" class="text-center">Nenhuma folha de ponto pendente.</td>
            </tr>
        }

        @foreach (var item in Model.Items)
        {
            var hoursWorked = $"{(int)item.TimeEntry.HoursWorked.TotalHours:00}:{item.TimeEntry.HoursWorked.Minutes:00}";

            <tr>
                <td>@item.EmployeeName</td>
                <td class="text-center">@item.Competence.ToString("MM/yyyy")</td>
                <td class="text-center">@item.PeriodStart.ToString("dd/MM/yyyy")</td>
                <td class="text-center">@item.PeriodEnd.ToString("dd/MM/yyyy")</td>
                <td class="text-center">@hoursWorked</td>
                <td class="text-center">@item.TimeEntry.DaysWorked</td>
                <td class="text-center">@(item.TimeEntry.IsConsistent ? "✅" : "❌")</td>
                <td class="text-end">
                    <button id="process-btn" type="button" class="btn btn-outline-primary btn-sm"
                            data-employee-id='@item.EmployeeId.ToString()'
                            data-employee-name="@item.EmployeeName"
                            data-competence-date="@item.Competence.ToString("yyyy-MM-dd")"
                            data-hours-worked="@hoursWorked"
                            data-days-worked="@item.TimeEntry.DaysWorked"
                            data-is-consistent="@(item.TimeEntry.IsConsistent ? "Sim" : "Não")">
                        Processar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_AjaxPagination" model="@(new AjaxPaginationViewModel(Model.TotalCount, Model.Page, Model.PageSize))" />

<!-- Modal de Confirmação -->
<div class="modal fade" id="processModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="processForm">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Processamento forçado?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <dl class="row">
                        <div class="d-none">
                            <dt class="col-sm-4">Employee ID</dt>
                            <dd class="col-sm-8" id="process-employeeId"></dd>
                        </div>

                        <dt class="col-sm-4">Funcionário</dt>
                        <dd class="col-sm-8" id="process-employeeName"></dd>

                        <dt class="col-sm-4">Competencia</dt>
                        <dd class="col-sm-8" id="process-competenceDate"></dd>

                        <dt class="col-sm-4">Horas Trabalhadas</dt>
                        <dd class="col-sm-8" id="process-hoursWorked"></dd>

                        <dt class="col-sm-4">Dias Trabalhados</dt>
                        <dd class="col-sm-8" id="process-daysWorked"></dd>

                        <dt class="col-sm-4">Consistente?</dt>
                        <dd class="col-sm-8" id="process-isConsistent"></dd>

                        <div id="process-errors" />

                    </dl>

                    <p>Tem certeza que deseja confirmar o processamento desta folha de pagamento?</p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">✔ Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>