@model IEnumerable<ProcessedPayrollViewModel>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EmployeeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmployeeDepartment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmployeeJobtitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GrossSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NetSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RegularSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalExtraEarnings)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalDeductions)
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="9" class="text-center">Nenhuma folha processada.</td>
            </tr>
        }

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.EmployeeName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmployeeDepartment)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmployeeJobtitle)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GrossSalary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NetSalary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RegularSalary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalExtraEarnings)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalDeductions)
                </td>
            </tr>
        }
    </tbody>
</table>