@model PagedResult<ProcessedPayrollViewModel>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameForInnerType((ProcessedPayrollViewModel m) => m.EmployeeName)
            </th>
            <th>
                @Html.DisplayNameForInnerType((ProcessedPayrollViewModel m) => m.EmployeeDepartment)
            </th>
            <th>
                @Html.DisplayNameForInnerType((ProcessedPayrollViewModel m) => m.EmployeeJobtitle)
            </th>
            <th>
                @Html.DisplayNameForInnerType((ProcessedPayrollViewModel m) => m.GrossSalary)
            </th>
            <th>
                @Html.DisplayNameForInnerType((ProcessedPayrollViewModel m) => m.NetSalary)
            </th>
            <th>
                @Html.DisplayNameForInnerType((ProcessedPayrollViewModel m) => m.RegularSalary)
            </th>
            <th>
                @Html.DisplayNameForInnerType((ProcessedPayrollViewModel m) => m.TotalExtraEarnings)
            </th>
            <th>
                @Html.DisplayNameForInnerType((ProcessedPayrollViewModel m) => m.TotalDeductions)
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="9" class="text-center">Nenhuma folha processada.</td>
            </tr>
        }

        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.EmployeeName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmployeeDepartment)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmployeeJobtitle)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GrossSalary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NetSalary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RegularSalary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalExtraEarnings)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalDeductions)
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_AjaxPagination" model="@(new AjaxPaginationViewModel(Model.TotalCount, Model.Page, Model.PageSize))" />