@model PagedResult<ProcessedPayrollViewModel>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Funcionário</th>
            <th>Setor</th>
            <th>Cargo</th>
            <th class="text-end">Salário Bruto</th>
            <th class="text-end">Salário Líquido</th>
            <th class="text-end">Salário Regular</th>
            <th class="text-end">Adicionais</th>
            <th class="text-end">Descontos</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="8" class="text-center">Nenhuma folha processada.</td>
            </tr>
        }

        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.EmployeeName</td>
                <td>@item.EmployeeDepartment</td>
                <td>@item.EmployeeJobtitle</td>
                <td class="text-end">@MaskHelper.MaskCurrency(item.GrossSalary)</td>
                <td class="text-end">@MaskHelper.MaskCurrency(item.NetSalary)</td>
                <td class="text-end">@MaskHelper.MaskCurrency(item.RegularSalary)</td>
                <td class="text-end">@MaskHelper.MaskCurrency(item.TotalExtraEarnings)</td>
                <td class="text-end">@MaskHelper.MaskCurrency(item.TotalDeductions)</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_AjaxPagination" model="@(new AjaxPaginationViewModel(Model.TotalCount, Model.Page, Model.PageSize))" />
