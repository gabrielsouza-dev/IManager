@model CompanyViewModel

@{
    var action = Model.IsActive ? "Desativar" : "Ativar";
    ViewData["Title"] = $"{action} Empresa";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">@action Empresa</h5>
                </div>

                <div class="card-body">
                    <div class="alert @(Model.IsActive ? "alert-warning" : "alert-info") mb-4">
                        Tem certeza que deseja <strong>@action.ToLower()</strong> a empresa <strong>@Model.TradeName</strong>?
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">CNPJ</dt>
                        <dd class="col-sm-8">@MaskHelper.MaskCnpj(Model.DocumentNumber)</dd>

                        <dt class="col-sm-4">Razão Social</dt>
                        <dd class="col-sm-8">@Model.LegalName</dd>

                        <dt class="col-sm-4">Nome Fantasia</dt>
                        <dd class="col-sm-8">@Model.TradeName</dd>

                        <dt class="col-sm-4">Data de Fundação</dt>
                        <dd class="col-sm-8">@Model.FoundedAt.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Data de Cadastro</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>

                <div class="card-footer bg-white d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                    <form asp-action="Delete" method="post" class="m-0">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn @(Model.IsActive ? "btn-danger" : "btn-success")">@action</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
