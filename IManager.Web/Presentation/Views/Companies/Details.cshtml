@model DetailsCompanyViewModel

@{
    ViewData["Title"] = "Detalhes da Empresa";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Detalhes da Empresa</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">@Model.TradeName</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">CNPJ</dt>
                <dd class="col-sm-9">@MaskHelper.MaskCnpj(Model.DocumentNumber)</dd>

                <dt class="col-sm-3">Razão Social</dt>
                <dd class="col-sm-9">@Model.LegalName</dd>

                <dt class="col-sm-3">Nome Fantasia</dt>
                <dd class="col-sm-9">@Model.TradeName</dd>

                <dt class="col-sm-3">Data de Fundação</dt>
                <dd class="col-sm-9">@Model.FoundedAt.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3">Data de Cadastro</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">Situação</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Ativa" : "Inativa")
                    </span>
                </dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">Informações da Empresa</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Quantidade de Funcionários</dt>
                <dd class="col-sm-9">@Model.Info.EmployeeCount</dd>

                <dt class="col-sm-3">Quantidade de Setores</dt>
                <dd class="col-sm-9">@Model.Info.DepartmentCount</dd>

                <dt class="col-sm-3">Salário Médio</dt>
                <dd class="col-sm-9">@Model.Info.AverageSalary.ToString("C")</dd>

                <dt class="col-sm-3">Custo Anual</dt>
                <dd class="col-sm-9">@Model.Info.AnnualPayrollCost.ToString("C")</dd>

                <dt class="col-sm-3">Último Usuário Cadastrado</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrWhiteSpace(Model.Info.LastCreatedUser))
                    {
                        <span>-</span>
                    }
                    else
                    {
                        <span>@Model.Info.LastCreatedUser - @Model.Info.LastCreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            Editar
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Voltar
        </a>
    </div>
</div>
