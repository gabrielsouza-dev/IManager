@model PagedResult<IndexPayslipViewModel>

@{
    ViewData["Title"] = "Holerites";
}

<h1>Holerites</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameForInnerType((IndexPayslipViewModel m) => m.CompetenceDate)
            </th>
            <th>
                @Html.DisplayNameForInnerType((IndexPayslipViewModel m) => m.CreatedAt)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var modelItem in Model.Items)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => modelItem.CompetenceDate)
                </td>
                <td>
                    @Html.DisplayFor(model => modelItem.CreatedAt)
                </td>
                <td>
                    <button type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#payslipModal"
                            data-payslip-id="@modelItem.Id">
                        Visualizar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    int total = Model.TotalCount;
    int pageSize = Model.PageSize;
    int page = Model.Page;

    int start = total == 0 ? 0 : ((page - 1) * pageSize) + 1;
    int end = Math.Min(page * pageSize, total);

    var totalPages = (int)Math.Ceiling((double)total / pageSize);
}

<div class="d-flex justify-content-end align-items-center mt-3 mb-3">
    <div class="d-flex align-items-center gap-3">

        <small class="text-muted">
            @if (total > 0)
            {
                <span>Mostrando @start–@end de @total registros</span>
            }
            else
            {
                <span>Nenhum registro encontrado</span>
            }
        </small>

        <form method="get" class="m-0 p-0">
            <select name="pageSize"
                    class="form-select w-auto"
                    onchange="this.form.submit()">
                @foreach (var size in new[] { 10, 25, 50, 100 })
                {
                    <option value="@size" selected="@(size == Model.PageSize)">
                        @size por página
                    </option>
                }
            </select>
        </form>

        <nav>
            <ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pageSize="@pageSize">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

<div class="modal fade"
     id="payslipModal"
     tabindex="-1"
     aria-labelledby="payslipModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="payslipModalLabel">
                    Visualizar holerite
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                </button>
            </div>

            <div class="modal-body p-0">
                <iframe id="payslipPdf"
                        style="width: 100%; height: 75vh; border: none;">
                </iframe>
            </div>

            <div class="modal-footer">
                <a id="downloadPayslip"
                   class="btn btn-primary">
                    Download
                </a>

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Fechar
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    const payslipModal = document.getElementById('payslipModal');

    payslipModal.addEventListener('show.bs.modal', event => {
        const button = event.relatedTarget;
        const payslipId = button.getAttribute('data-payslip-id');

        const pdfUrl = '@Url.Action("VisualizePdf")' + '?id=' + payslipId;
        const downloadUrl = '@Url.Action("DownloadPdf")' + '?id=' + payslipId;

        document.getElementById('payslipPdf').src = pdfUrl;
        document.getElementById('downloadPayslip').href = downloadUrl;
    });

    payslipModal.addEventListener('hidden.bs.modal', () => {
        document.getElementById('payslipPdf').src = '';
    });
</script>