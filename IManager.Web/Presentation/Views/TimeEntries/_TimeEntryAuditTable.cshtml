@using IManager.Web.Domain.Enums
@model PagedResult<TimeEntryAudit>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Funcionário</th>
            <th class="text-center">Data</th>
            <th class="text-center">Batidas Originais</th>
            <th class="text-center">Novas Batidas</th>
            <th class="text-center">Total</th>
            <th class="text-center">Consistente</th>
            <th>Solicitado em</th>
            <th>Auditado em</th>
            <th>Auditado por</th>
            <th class="text-center">Situação</th>
        </tr>
    </thead>

    <tbody>
        @if(!Model.Items.Any())
        {
            <tr>
                <td colspan="10" class="text-center">Nenhum ajuste de ponto realizado.</td>
            </tr>
        }

        @foreach (var timeEntry in Model.Items)
        {
            var originalChecks = string.Join(" ",
                timeEntry.OriginalChecks
                .OrderBy(c => c.TimestampLocal)
                .Select(c => c.TimestampLocal.ToString("HH:mm")));

            var newChecks = string.Join(" ",
                timeEntry.NewChecks
                    .OrderBy(c => c.TimestampLocal)
                    .Select(c => c.TimestampLocal.ToString("HH:mm")));

            <tr id="row-@timeEntry.Id">
                <td>@timeEntry.EmployeeName</td>
                <td class="text-center">@timeEntry.Date.ToString("dd/MM/yyyy")</td>
                <td class="text-center">@originalChecks</td>
                <td class="text-center">@newChecks</td>
                <td class="text-center">@timeEntry.HoursWorked.ToString(@"hh\:mm")</td>
                <td class="text-center">@(timeEntry.IsConsistent ? "✅" : "❌")</td>
                <td>@timeEntry.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@timeEntry.LastModified.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@timeEntry.LastModifierName</td>
                <td class="text-center">
                    <span class="badge @(timeEntry.Status == TimeEntryStatus.Accepted ? "bg-success" : "bg-danger")">@timeEntry.Status.ToDisplayName()</span>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_AjaxPagination" model="@(new AjaxPaginationViewModel(Model.TotalCount, Model.Page, Model.PageSize))" />
