@model IEnumerable<DateOnly>

@{
    ViewData["Title"] = "Gerenciamento de Ponto";
}

<div class="btn-group w-100" role="group">
    <input type="radio" class="btn-check" name="tabs" id="pending" checked>
    <label class="btn btn-outline-primary" for="pending">
        Pendencias
    </label>

    <input type="radio" class="btn-check" name="tabs" id="approved">
    <label class="btn btn-outline-primary" for="approved">
        Historico de Auditoria
    </label>
</div>

<label for="data" class="mt-3">
    Competência:
    <select id="data" name="data">
        <option value="">Selecione um mês</option>

        @foreach (var data in Model)
        {
            <option value="@data.ToString("yyyy-MM-dd")">
                @data.ToString("MM/yyyy")
            </option>
        }
    </select>
</label>

<div class="mt-3" id="tableContainer" />


<script>
    const pending = document.getElementById("pending");
    const approved = document.getElementById("approved");
    const tableContainer = document.getElementById("tableContainer");

    function updateTabs() {
        document.getElementById("data").value = "";

        tableContainer.innerHTML = null;
    }

    let currentPage = 1;
    let currentPageSize = 10;

    function fetchTimeEntryAudit(selectedDate) {
        fetch(`/TimeEntries/_TimeEntryAuditTable?date=${selectedDate}&page=${currentPage}&pageSize=${currentPageSize}`)
            .then(response => response.text())
            .then(html => {
                tableContainer.innerHTML = html;
            })
            .catch(error => console.error('Error fetching time entries:', error));
    }

    function fetchTimeEntryPending(selectedDate) {

        fetch(`/TimeEntries/_TimeEntryPendingTable?date=${selectedDate}&page=${currentPage}&pageSize=${currentPageSize}`)
            .then(response => response.text())
            .then(html => {
                tableContainer.innerHTML = html;
            })
            .catch(error => console.error('Error fetching time entries:', error));
    }

    function loadTable() {
        const selectedDate = document.getElementById("data").value;
        if (!selectedDate) return;

        if (pending.checked) {
            fetchTimeEntryPending(selectedDate);
        } else if (approved.checked) {
            fetchTimeEntryAudit(selectedDate);
        }
    }

    // Paginação dos partials (_AjaxPagination)
    tableContainer.addEventListener("click", function (e) {
        const link = e.target.closest("a[data-page]");
        if (!link) return;

        e.preventDefault();
        currentPage = parseInt(link.dataset.page);
        loadTable();
    });

    tableContainer.addEventListener("change", function (e) {
        const select = e.target.closest("select[data-page-size]");
        if (!select) return;

        currentPageSize = parseInt(select.value);
        currentPage = 1;
        loadTable();
    });

    pending.addEventListener("change", updateTabs);
    approved.addEventListener("change", updateTabs);

    updateTabs();

    document.getElementById("data").addEventListener("change", function () {
        currentPage = 1;
        loadTable();
    });
</script>